{
  "name": "@lizuz/mini-app-types",
  "version": "1.0.9",
  "description": "Shared type definitions for GSA Mini App SDK – consumed by the SDK itself, host shells, and mini apps",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm  build"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
